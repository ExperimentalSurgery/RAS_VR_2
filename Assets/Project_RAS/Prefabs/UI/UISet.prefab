  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 933f9f9ccb2121d4c87c1230435cbde6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textLabelObject: {fileID: 5728491895591742227}
  textBodyObject: {fileID: 6147622711473807473}
  stepLabelTexts:
  - Switch to Mixed Reality Mode
  - Begin with the physical liver model
  - Switch to virtual reality mode
  - Test visual deformation
  - Enable haptic feedback
  stepBodyTexts:
  - If you are currently in virtual reality, press the light button on either stylus
    to switch to mixed reality mode.
  - Hold one stylus in each hand and gently explore the surface of the physical liver
    model to become familiar with its shape and texture.
  - Once finished, set aside the physical liver model and platform. Then, press the
    light button on either stylus to activate virtual reality mode.
  - Use the stylus to interact with the virtual liver model. Observe how the surface
    visually deforms in response to your movements.
  - Press the dark button on the stylus to activate haptic feedback. You can now
    feel the virtual liver and compare its tactile response to the physical model.
  nextButton: {fileID: 1696221006611412379}
  toLoadNextScene: 0
