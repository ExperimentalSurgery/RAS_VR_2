  m_Name: 
  m_EditorClassIdentifier: 
  textLabelObject: {fileID: 811249578667454867}
  textBodyObject: {fileID: 831486027040349644}
  stepLabelTexts:
  - Stiffness Assessment
  - Initial Interaction
  stepBodyTexts:
  - Please proceed to move the instrument slowly to the right in a linear movement.
    When you arrive at the tumor, take a moment to differentiate between healthy
    liver tissue and more stiff tumor-affected areas. simulating the real-life need
    for haptic feedback to assess margins before resection.
  - Please pick up the surgical instrument. Observe the interaction site on the liver.
    Start tracing the surface of the liver from the left side. Take a moment to perceive
    the existing stiffness and resistance quality of the healthy tissue.
  nextButton: {fileID: 0}
  toLoadNextScene: 0
