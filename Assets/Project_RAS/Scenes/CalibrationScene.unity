  uiInstructionsText: {fileID: 1085434050}
  indexText: {fileID: 2003291498}
  initialInstruction: Put the styluses on the table before calibration and pick up
    the controllers
  uiIndex: 0
  instructions:
  - "Insert the bottom tip of the right controller into socket 1 \u2192 press calibrate
    button."
  - "Insert the bottom tip of the right controller into socket 2 \u2192 press calibrate
    button."
  - "Insert the bottom tip of the right controller into socket 3 \u2192 press calibrate
    button."
  - "Insert the bottom tip of the right controller into socket 4 \u2192 press calibrate
    button."
  - "Start with right or left robotic stylus \u2192 insert stylus into socket R1
    or L1 (on the corresponding side) \u2192 press dark button."
  - Complete the console calibration with the controller first.
  - "Insert right stylus into socket R2 \u2192 press dark button."
  - "Insert right stylus into socket R3 \u2192 press dark button."
  - "Insert right stylus into socket R4 \u2192 press dark button."
  - "Repeat for left stylus \u2192 insert left stylus into socket L1 \u2192 press
    dark button."
  - "Repeat for for right stylus \u2192 insert right stylus into socket R1 \u2192
    press dark button."
  - "Insert left stylus into socket L2 \u2192 press dark button."
  - "Insert left stylus into socket L3 \u2192 press dark button."
  - "Insert left stylus into socket L4 \u2192 press dark button."
