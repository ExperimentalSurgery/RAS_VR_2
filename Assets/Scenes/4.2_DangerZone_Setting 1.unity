  m_Script: {fileID: 11500000, guid: 933f9f9ccb2121d4c87c1230435cbde6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textLabelObject: {fileID: 1311105777347002946}
  textBodyObject: {fileID: 7294369809024623351}
  stepLabelTexts:
  - Switch to Virtual Reality Mode
  - Approaching the Urethra
  - Entering the Critical Zone
  - Experiencing a Critical Zone
  stepBodyTexts:
  - If you are currently in mixed reality, press the light button on either stylus
    to switch to virtual reality mode.
  - As you move the stylus closer to the urethra, a visual barrier will appear around
    it. This signals that you are entering the critical zone.
  - When the stylus crosses into the critical zone, you will experience a combination
    of visual changes and haptic feedback. This dual feedback helps simulate the
    physical sensitivity of the area and highlights the need for precision.
  - Please proceed slowly and observe both visual cues and tactile responses as you
    interact with this zone.
  nextButton: {fileID: 5362090612979543733}
